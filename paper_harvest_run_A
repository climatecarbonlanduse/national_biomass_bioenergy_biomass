# -------------------------------
# 8. REGIONAL BIOMASS EXTRACTION SUMMARY (AREA-WEIGHTED FIX)
# -------------------------------
print("\n=== REGIONAL BIOMASS EXTRACTION SUMMARY ===")

# Paths to the field shapefile (using the agri base_path) and the regional borders
FIELD_STATUS_SHP = f"{base_path}/field_utilization_status_agri.shp"
PO8_SHP_PATH = r'<INSERT_REGIONAL_BOUNDARIES_SHAPEFILE_PATH_HERE>'

if os.path.exists(FIELD_STATUS_SHP) and os.path.exists(PO8_SHP_PATH):
    print("Loading field status and regional borders...")
    fields_gdf = gpd.read_file(FIELD_STATUS_SHP)
    po8_gdf = gpd.read_file(PO8_SHP_PATH)
    
    # Ensure standard projected CRS for accurate area math (e.g., SWEREF 99 TM "EPSG:3006" for Sweden)
    # Adjust target_crs to match your specific geographic context
    target_crs = "EPSG:3006" 
    fields_gdf = fields_gdf.to_crs(target_crs)
    po8_gdf = po8_gdf.to_crs(target_crs)
        
    print("Performing area-weighted spatial intersection...")
    
    # Identify the region column
    possible_cols = [c for c in po8_gdf.columns if any(x in c.upper() for x in ['PO', 'PROD', 'NAMN', 'NAME'])]
    REGION_COL = possible_cols[0] if possible_cols else 'PR_ID'

    # 1. Calculate the original area of the polygons
    fields_gdf['orig_area'] = fields_gdf.geometry.area
    
    # 2. Geometrically intersect polygons (this physically slices them along region borders)
    po8_subset = po8_gdf[[REGION_COL, 'geometry']]
    intersected = gpd.overlay(fields_gdf, po8_subset, how='intersection')
    
    # 3. Calculate the new area of the sliced pieces
    intersected['split_area'] = intersected.geometry.area
    
    # 4. Calculate what proportion of the original polygon ended up in each slice
    intersected['area_prop'] = intersected['split_area'] / intersected['orig_area']

    print("Distributing biomass proportionally to regions...")
    
    # 5. Multiply the biomass totals by the proportion that falls into each region
    for col in ['orig_bio_t', 'used_bio_t', 'leftover_t']:
        if col in intersected.columns:
            intersected[col] = intersected[col].fillna(0) * intersected['area_prop']

    print("Summarizing totals per region...")
    
    # 6. Group by Region and sum the newly weighted values
    regional_summary = intersected.groupby(REGION_COL).agg({
        'orig_bio_t': 'sum',      
        'used_bio_t': 'sum',      
        'leftover_t': 'sum'       
    }).reset_index()

    # Calculate actual percentages
    regional_summary['Extraction_Rate_%'] = (regional_summary['used_bio_t'] / regional_summary['orig_bio_t'] * 100).fillna(0).round(1)
    regional_summary['Stranded_Rate_%'] = (regional_summary['leftover_t'] / regional_summary['orig_bio_t'] * 100).fillna(0).round(1)

    # Clean up column names for the final output
    regional_summary = regional_summary.rename(columns={
        REGION_COL: 'Region',
        'orig_bio_t': 'Total Potential (t)',
        'used_bio_t': 'Extracted Biomass (t)',
        'leftover_t': 'Stranded Biomass (t)'
    })

    # Sort to show highest potential regions first
    regional_summary = regional_summary.sort_values(by='Total Potential (t)', ascending=False)

    print("\nRegional Extraction Breakdown:")
    # Using format to make the printout cleaner
    print(regional_summary.to_string(index=False, float_format="{:,.1f}".format))

    reg_summary_fp = f"{output_folder}/agri_regional_extraction_summary.csv"
    regional_summary.to_csv(reg_summary_fp, index=False)
    print(f"\n✅ Regional summary saved to:\n{reg_summary_fp}")
    
    # Optional check to verify total sums match
    check_total = regional_summary['Total Potential (t)'].sum()
    print(f"\nVerification - Distributed National Total Potential: {check_total:,.0f} t")

else:
    print(f"⚠️ Could not find required shapefiles. Check paths:\n{FIELD_STATUS_SHP}\n{PO8_SHP_PATH}")

print("\n🎉 SCRIPT COMPLETE! 🎉")