import geopandas as gpd
import pandas as pd
import matplotlib.pyplot as plt
import seaborn as sns
import numpy as np
import os

# -------------------------------
# 1. PATHS
# -------------------------------
# Set your local or repository base directory here
base_path = r"<INSERT_BASE_DIRECTORY_PATH_HERE>"

plants_fp = f"{base_path}/plants_with_logistics.shp"
flows_fp = f"{base_path}/flows_with_logistics.csv"

output_folder = f"{base_path}/analysis_outputs"
os.makedirs(output_folder, exist_ok=True)

# -------------------------------
# 2. LOAD DATA
# -------------------------------
print("Loading data...")
plants = gpd.read_file(plants_fp)
flows = pd.read_csv(flows_fp)

# -------------------------------
# 3. CLEAN COLUMN NAMES (IMPORTANT)
# -------------------------------
plants = plants.rename(columns={
    'bio_in_t': 'biomass_input_t',
    'bio_out_t': 'biochar_output_t',
    'oil_out_t': 'biooil_output_t', 
    'gas_out_t': 'biogas_output_t', 
    'ref_km': 'refinery_km',            
    'oil_tkm': 'oil_tkm',
    'avg_km': 'avg_dist_km',
    'tkm_per_t': 'intensity_tkm_per_t', 
    'tot_tkm': 'total_tkm',   
    'road_tkm': 'total_tkm'
})

# -------------------------------
# 4. SOC + NITROGEN CALCULATIONS
# -------------------------------
print("Calculating SOC and Nitrogen emissions...")

# --- AREA ESTIMATION ---
# Adjust yields and loss factors based on your local case study context
AVG_YIELD_T_HA = 3.0
plants["est_area_ha"] = plants["biomass_input_t"] / AVG_YIELD_T_HA

# --- SOC LOSS ---
SOC_LOSS_PER_HA = 0.160
plants["soc_loss_t"] = plants["est_area_ha"] * SOC_LOSS_PER_HA

# --- NITROGEN EMISSIONS ---
N_ADDED_KG_PER_HA = 6 * AVG_YIELD_T_HA
N_DIRECT_EMISSIONS_FACTOR = 0.01
N_PROD_EMISSIONS_CO2E_PER_KG = 3.5
TRACTOR_EMISSION_CO2E_PER_HA = 45.0
N2O_GWP = 298

n_dir = (N_ADDED_KG_PER_HA * N_DIRECT_EMISSIONS_FACTOR * N2O_GWP)
n_prod = (N_ADDED_KG_PER_HA * N_PROD_EMISSIONS_CO2E_PER_KG)
tot_n_co2e_per_ha_kg = n_dir + n_prod + TRACTOR_EMISSION_CO2E_PER_HA

plants["n_emiss_t_co2e"] = (plants["est_area_ha"] * tot_n_co2e_per_ha_kg) / 1000

# -------------------------------
# 5. BASIC SYSTEM STATS
# -------------------------------
print("\n=== SYSTEM SUMMARY ===")

total_biomass = plants["biomass_input_t"].sum()
total_soc = plants["soc_loss_t"].sum()
total_n = plants["n_emiss_t_co2e"].sum()

print(f"Total biomass used: {total_biomass:,.0f} t")
print(f"Total SOC loss: {total_soc:,.0f} t")
print(f"Total Nitrogen emissions: {total_n:,.0f} t CO2e")

# -------------------------------
# 6. FINAL 4-PANEL FIGURE
# -------------------------------
print("\nGenerating final plots...")

sns.set_theme(style="whitegrid")

df = plants.copy()

# Remove zero plants
df = df[df["biomass_input_t"] > 0]

# Cap outliers
df["biomass_input_t"] = df["biomass_input_t"].clip(
    upper=df["biomass_input_t"].quantile(0.98)
)

fig, axes = plt.subplots(2, 2, figsize=(16, 12))

# A. Distance vs Biomass
sns.scatterplot(
    data=df, x="avg_dist_km", y="biomass_input_t",
    size="biomass_input_t", sizes=(30, 300),
    alpha=0.6, ax=axes[0, 0]
)
axes[0, 0].set_title("A. Distance vs Biomass Intake")

# B. Distance vs Biochar Output
sns.scatterplot(
    data=df, x="avg_dist_km", y="biochar_output_t",
    size="biochar_output_t", sizes=(30, 300),
    alpha=0.6, ax=axes[0, 1]
)
axes[0, 1].set_title("B. Distance vs Biochar Output")

# C. Distance vs SOC Loss
sns.scatterplot(
    data=df, x="avg_dist_km", y="soc_loss_t",
    size="biomass_input_t", sizes=(30, 300),
    alpha=0.6, ax=axes[1, 0]
)
axes[1, 0].set_title("C. Distance vs SOC Loss")

# D. Distance vs Nitrogen
sns.scatterplot(
    data=df, x="avg_dist_km", y="n_emiss_t_co2e",
    size="biomass_input_t", sizes=(30, 300),
    alpha=0.6, ax=axes[1, 1]
)
axes[1, 1].set_title("D. Distance vs Nitrogen Emissions")

for ax in axes.flat:
    ax.set_xlabel("Average Distance (km)")
    ax.spines["top"].set_visible(False)
    ax.spines["right"].set_visible(False)

plt.tight_layout()

plot_path = f"{output_folder}/agri_distance_analysis.png"
plt.savefig(plot_path, dpi=400)
plt.close()

print(f"✅ Plot saved: {plot_path}")

