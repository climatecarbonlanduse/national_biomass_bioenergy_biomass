def export_sectoral_analysis_excel():
    print("\n" + "="*60)
    print("📁 EXPORTING FULL SECTORAL ANALYSIS TO EXCEL 📁")
    print("="*60)
    
    output_dir = r'<INSERT_SECTORAL_OUTPUT_DIR_HERE>'
    os.makedirs(output_dir, exist_ok=True)
    
    all_data = []
    
    for scen_name in ['Heatplants', 'Agri', 'BioOil']:
        config = scenarios[scen_name]
        summary_path = os.path.join(config['data_out'], f'{scen_name.lower()}_po8_summary.xlsx')
        
        if not os.path.exists(summary_path):
            print(f"⚠️ Data file not found for {scen_name}: {summary_path}")
            continue
            
        df = pd.read_excel(summary_path)
        PO8_ID_COL = df.columns[0]
        
        for col in df.columns[1:]:
            df[col] = pd.to_numeric(df[col], errors='coerce')
        df = df.dropna(subset=['emit_trans_tCO2', 'net_tCO2'])
        df = df[df[PO8_ID_COL].isin([1, 2, 3, 4, 5])].copy()
        
        prim_col = config['primary_sink_col']
        sec_col = config.get('secondary_sink_col', 'dummy_sec')
        tert_col = config.get('tertiary_sink_col', 'dummy_tert')
        
        for col in [prim_col, sec_col, tert_col]:
            if col not in df.columns:
                df[col] = 0.0
                
        if 'Biochar' in config['primary_sink_label']:
            biochar_col, saf_col = prim_col, sec_col
        else:
            biochar_col, saf_col = sec_col, prim_col
            
        clean_df = pd.DataFrame({
            'Scenario': scen_name,
            'Production_Region_PR': df[PO8_ID_COL].astype(int).astype(str),
            'Transport_Emissions_tCO2 (+)': df['emit_trans_tCO2'],
            'SOC_Loss_Emissions_tCO2 (+)': df['emit_soc_tCO2'],
            'Nitrogen_Emissions_tCO2 (+)': df['emit_n_tCO2'],
            'Biochar_Sink_tCO2 (-)': -df[biochar_col],
            'SAF_Substitution_tCO2 (-)': -df[saf_col],
            'Fuel_Substitution_tCO2 (-)': -df[tert_col],
            'Net_Balance_tCO2': df['net_tCO2']
        })
        
        all_data.append(clean_df)
        
    if all_data:
        final_df = pd.concat(all_data, ignore_index=True)
        totals_df = final_df.groupby('Scenario').sum(numeric_only=True).reset_index()
        totals_df['Production_Region_PR'] = 'ALL (Total)'
        
        final_df = pd.concat([final_df, totals_df], ignore_index=True)
        final_df['sort_key'] = final_df['Production_Region_PR'].apply(lambda x: 999 if x == 'ALL (Total)' else int(x))
        final_df = final_df.sort_values(by=['Scenario', 'sort_key']).drop(columns=['sort_key'])
        
        output_path = os.path.join(output_dir, 'Sectoral_Analysis_Full_Balance.xlsx')
        final_df.to_excel(output_path, index=False)
        print(f"✅ Successfully saved full sectoral data to:\n{output_path}")
    else:
        print("❌ No data found to export.")

