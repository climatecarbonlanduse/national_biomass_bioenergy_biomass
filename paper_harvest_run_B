# =================================================================
# 3. CORE PROCESSING FUNCTION
# =================================================================
def run_scenario_analysis(scenario_name, config, po8_gdf):
    print(f"\n{'='*50}\n🚀 RUNNING SCENARIO: {scenario_name}\n{'='*50}")
    os.makedirs(config['data_out'], exist_ok=True)
    
    print("--- Loading Spatial Data ---")
    gdf = gpd.read_file(config['shp_path'])
    if gdf.crs != po8_gdf.crs:
        gdf = gdf.to_crs(po8_gdf.crs)

    print("--- Standardizing Shapefile Column Names ---")
    rename_map = {
        'oil_out_t': 'biooil_t',   
        'gas_out_t': 'biogas_t',   
        'bc_out_t': 'bio_out_t'    
    }
    
    for old_col, new_col in rename_map.items():
        if old_col in gdf.columns:
            if new_col in gdf.columns:
                gdf = gdf.drop(columns=[new_col])
            gdf = gdf.rename(columns={old_col: new_col})
            
    gdf = gdf.loc[:, ~gdf.columns.duplicated()]
    
    print("--- Linking Plants to PO8 Regions ---")
    gdf = gpd.sjoin(gdf, po8_gdf, how='left', predicate='within')
    possible_cols = [c for c in po8_gdf.columns if any(x in c.upper() for x in ['PO', 'PROD', 'NAMN', 'NAME'])]
    PO8_ID_COL = possible_cols[0] if possible_cols else 'index_right'
    id_col_to_check = 'plt_name' if 'plt_name' in gdf.columns else ('plant_id' if 'plant_id' in gdf.columns else None)
    if id_col_to_check:
        gdf = gdf.drop_duplicates(subset=[id_col_to_check])
    
    # Fill NaNs globally
    gdf['soc_los_t'] = gdf['soc_los_t'].fillna(0)
    gdf['n_ems_co2e'] = gdf['n_ems_co2e'].fillna(0)
    
    if 'biooil_t' not in gdf.columns: gdf['biooil_t'] = 0
    if 'biogas_t' not in gdf.columns: gdf['biogas_t'] = 0
    gdf['biooil_t'] = gdf['biooil_t'].fillna(0)
    gdf['biogas_t'] = gdf['biogas_t'].fillna(0)

    print("--- Calculating Climate Metrics ---")
    
    # Constants
    biooil_substit_effect_coe2_per_ton = 0.4
    biogas_substit_effect_coe2_per_ton = 0.3
    carbon_content_of_biochar_in_prod = 0.64
    carbon_longevity_in_bicohar_in_fields = 0.90 
    Emission_factor_trucks = 0.00009
    SAF_product_effect = 0.3
    SAF_effectivity = 0.75
    SAF_CO2e_subst_final_effect = 3.1
    biochar_in_biooil_factor = 0.33

    if scenario_name == 'Heatplants':
        gdf['tonne_km'] = gdf['bio_in_t'] * gdf['tkm_per_t']
        gdf['emit_trans_tCO2'] = (gdf['tonne_km'] * Emission_factor_trucks)
        gdf['char_t'] = gdf['bio_out_t']
        gdf['sink_tCO2'] = gdf['char_t'] * carbon_content_of_biochar_in_prod * carbon_longevity_in_bicohar_in_fields * CO2_CONVERSION
        gdf['saf_t'] = gdf['biooil_t'] * SAF_product_effect
        gdf['effective_saf_t'] = gdf['saf_t'] * SAF_effectivity
        gdf['avoided_tCO2_saf'] = gdf['effective_saf_t'] * SAF_CO2e_subst_final_effect
        gdf['avoided_tCO2_fuels'] = gdf['biogas_t'] * biogas_substit_effect_coe2_per_ton
        
    elif scenario_name == 'Agri':
        gdf['tonne_km'] = gdf['bio_out_t'] * gdf['tkm_per_t']
        gdf['emit_trans_tCO2'] = (gdf['tonne_km'] * Emission_factor_trucks)
        gdf['char_t'] = gdf['bio_out_t']
        gdf['sink_tCO2'] = gdf['char_t'] * carbon_content_of_biochar_in_prod * carbon_longevity_in_bicohar_in_fields * CO2_CONVERSION
        gdf['saf_t'] = gdf['biooil_t'] * SAF_product_effect
        gdf['effective_saf_t'] = gdf['saf_t'] * SAF_effectivity
        gdf['avoided_tCO2_saf'] = gdf['effective_saf_t'] * SAF_CO2e_subst_final_effect
        gdf['avoided_tCO2_fuels'] = gdf['biogas_t'] * biogas_substit_effect_coe2_per_ton
        
    elif scenario_name == 'BioOil':
        gdf['tonne_km'] = gdf['bio_in_t'] * gdf['tkm_per_t']
        gdf['emit_trans_tCO2'] = gdf['tonne_km'] * Emission_factor_trucks
        gdf['saf_t'] = gdf['biooil_t'] * SAF_product_effect
        gdf['effective_saf_t'] = gdf['saf_t'] * SAF_effectivity
        gdf['avoided_tCO2'] = gdf['effective_saf_t'] * SAF_CO2e_subst_final_effect
        gdf['char_added_t'] = gdf['bio_out_t'] 
        gdf['added_sink_tCO2'] = gdf['char_added_t'] * carbon_content_of_biochar_in_prod * carbon_longevity_in_bicohar_in_fields * CO2_CONVERSION
        gdf['avoided_tCO2_fuels'] = gdf['biogas_t'] * biogas_substit_effect_coe2_per_ton
    
    print("--- Calculating Field Emissions based on Plant Inputs ---")
    SOC_LOSS_TC_PER_TONNE = 0.0533 
    N_ADDED_KG_PER_TONNE = 6.0 
    TRACTOR_CO2E_KG_PER_TONNE = 15.0 
    tot_n_co2e_per_tonne_kg = (N_ADDED_KG_PER_TONNE * 0.01 * 298) + (N_ADDED_KG_PER_TONNE * 3.5) + TRACTOR_CO2E_KG_PER_TONNE

    gdf['emit_soc_tCO2'] = gdf['bio_in_t'] * SOC_LOSS_TC_PER_TONNE * CO2_CONVERSION
    gdf['emit_n_tCO2'] = (gdf['bio_in_t'] * tot_n_co2e_per_tonne_kg) / 1000.0

    if scenario_name == 'Heatplants':
        import re
        hp_multipliers = {1: 0.247, 2: 0.442, 3: 0.430, 4: 0.948, 5: 0.769}
        def get_mult(val):
            match = re.search(r'\d+', str(val))
            return hp_multipliers.get(int(match.group()), 1.0) if match else 1.0
            
        gdf['mult'] = gdf[PO8_ID_COL].apply(get_mult)
        gdf['emit_soc_tCO2'] *= gdf['mult']
        gdf['emit_n_tCO2'] *= gdf['mult']
        gdf = gdf.drop(columns=['mult'])

    gdf['total_emit_tCO2'] = gdf['emit_trans_tCO2'] + gdf['emit_soc_tCO2'] + gdf['emit_n_tCO2']
    
    prim_col = config['primary_sink_col']
    sec_col = config.get('secondary_sink_col', 'dummy_sec')
    tert_col = config.get('tertiary_sink_col', 'dummy_tert')

    if sec_col not in gdf.columns: gdf[sec_col] = 0.0
    if tert_col not in gdf.columns: gdf[tert_col] = 0.0
    
    gdf['net_tCO2'] = gdf['total_emit_tCO2'] - (gdf[prim_col] + gdf[sec_col] + gdf[tert_col])
    
    print(f"--- Summarizing totals for {PO8_ID_COL} ---")
    agg_dict = {
        'bio_in_t': 'sum',
        'bio_out_t': 'sum',
        'emit_trans_tCO2': 'sum',
        'emit_soc_tCO2': 'sum',
        'emit_n_tCO2': 'sum',
        'total_emit_tCO2': 'sum',
        prim_col: 'sum',
        sec_col: 'sum',
        tert_col: 'sum',
        'net_tCO2': 'sum'
    }
    
    if 'plt_name' in gdf.columns: agg_dict['plt_name'] = 'count'
    elif 'plant_id' in gdf.columns: agg_dict['plant_id'] = 'count'

    po8_summary = gdf.groupby(PO8_ID_COL).agg(agg_dict).reset_index()
    if 'plt_name' in po8_summary.columns: po8_summary = po8_summary.rename(columns={'plt_name': 'plant_count'})
    if 'plant_id' in po8_summary.columns: po8_summary = po8_summary.rename(columns={'plant_id': 'plant_count'})

    po8_summary = po8_summary.sort_values(by='net_tCO2')
    po8_summary['climate_role'] = po8_summary['net_tCO2'].apply(lambda x: 'Net Sink' if x < 0 else 'Net Source')

    print("--- Saving Data Outputs ---")
    plant_out = os.path.join(config['data_out'], f'{scenario_name.lower()}_plant_results.xlsx')
    summary_out = os.path.join(config['data_out'], f'{scenario_name.lower()}_po8_summary.xlsx')
    spatial_out = os.path.join(config['data_out'], f'{scenario_name.lower()}_final_climate_results.shp')

    gdf.drop(columns='geometry').to_excel(plant_out, index=False)
    po8_summary.to_excel(summary_out, index=False)
    
    id_col_shp = 'plt_name' if 'plt_name' in gdf.columns else 'plant_id'
    gdf[[PO8_ID_COL, id_col_shp, 'net_tCO2', 'geometry']].copy().to_file(spatial_out)

    generate_plots(scenario_name, po8_summary, config, PO8_ID_COL)
    print(f"✅ Analysis for {scenario_name} Complete!")

