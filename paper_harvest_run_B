# 4. PLOTTING FUNCTION
# =================================================================
def generate_plots(scenario_name, po8_summary, config, PO8_ID_COL):
    print("--- Generating Plots ---")
    po8_summary = po8_summary.sort_values(by=PO8_ID_COL)
    prim_col = config['primary_sink_col']
    sec_col = config.get('secondary_sink_col', 'dummy_sec')
    tert_col = config.get('tertiary_sink_col', 'dummy_tert')

    if sec_col not in po8_summary.columns: po8_summary[sec_col] = 0.0
    if tert_col not in po8_summary.columns: po8_summary[tert_col] = 0.0
    
    cols_to_numeric = [PO8_ID_COL, 'emit_trans_tCO2', 'emit_soc_tCO2', 'emit_n_tCO2', prim_col, sec_col, tert_col, 'net_tCO2']
    for col in cols_to_numeric:
        po8_summary[col] = pd.to_numeric(po8_summary[col], errors='coerce')

    po8_summary = po8_summary.dropna(subset=cols_to_numeric)
    plot_df = po8_summary[po8_summary[PO8_ID_COL].isin([1, 2, 3, 4, 5])].copy()
    
    sns.set_theme(style="whitegrid")
    
    color_prim = '#2ecc71' if 'Biochar' in config['primary_sink_label'] else '#3498db'
    color_sec = '#3498db' if color_prim == '#2ecc71' else '#2ecc71'
    color_tert = '#9b59b6'

    plot_df[PO8_ID_COL] = plot_df[PO8_ID_COL].astype(str)
    avg_vals = po8_summary[['emit_trans_tCO2', 'emit_soc_tCO2', 'emit_n_tCO2', prim_col, sec_col, tert_col, 'net_tCO2']].sum() / TOTAL_HECTARES

    fig, ax1 = plt.subplots(figsize=(14, 8))
    ax2 = ax1.twinx() 

    x_regions = [0, 1, 2, 3, 4]
    x_avg = [5]
    labels = list(plot_df[PO8_ID_COL]) + ["Total Avg\n(per ha)"]

    ax1.bar(x_regions, plot_df['emit_trans_tCO2'], color='#e74c3c', label='Transport', alpha=0.8, width=0.6)
    ax1.bar(x_regions, plot_df['emit_soc_tCO2'], bottom=plot_df['emit_trans_tCO2'], color='#d35400', label='SOC Loss', alpha=0.8, width=0.6)
    ax1.bar(x_regions, plot_df['emit_n_tCO2'], bottom=plot_df['emit_trans_tCO2'] + plot_df['emit_soc_tCO2'], color='#f39c12', label='Nitrogen', alpha=0.8, width=0.6)
    
    ax1.bar(x_regions, -plot_df[prim_col], color=color_prim, label=config['primary_sink_label'], alpha=0.8, width=0.6)
    ax1.bar(x_regions, -plot_df[sec_col], bottom=-plot_df[prim_col], color=color_sec, label=config.get('secondary_sink_label', '_nolegend_'), alpha=0.8, width=0.6)
    ax1.bar(x_regions, -plot_df[tert_col], bottom=-plot_df[prim_col] - plot_df[sec_col], color=color_tert, label=config.get('tertiary_sink_label', '_nolegend_'), alpha=0.8, width=0.6)
    ax1.scatter(x_regions, plot_df['net_tCO2'], color='black', s=80, label='Net Impact', zorder=5, edgecolor='white')

    ax2.bar(x_avg, [avg_vals['emit_trans_tCO2']], color='#e74c3c', alpha=0.6, width=0.6, hatch='//')
    ax2.bar(x_avg, [avg_vals['emit_soc_tCO2']], bottom=[avg_vals['emit_trans_tCO2']], color='#d35400', alpha=0.4, width=0.6, hatch='//')
    ax2.bar(x_avg, [avg_vals['emit_n_tCO2']], bottom=[avg_vals['emit_trans_tCO2'] + avg_vals['emit_soc_tCO2']], color='#f39c12', alpha=0.4, width=0.6, hatch='//')
    
    ax2.bar(x_avg, [-avg_vals[prim_col]], color=color_prim, alpha=0.6, width=0.6, hatch='//')
    ax2.bar(x_avg, [-avg_vals[sec_col]], bottom=[-avg_vals[prim_col]], color=color_sec, alpha=0.6, width=0.6, hatch='//')
    ax2.bar(x_avg, [-avg_vals[tert_col]], bottom=[-avg_vals[prim_col] - avg_vals[sec_col]], color=color_tert, alpha=0.6, width=0.6, hatch='//')
    ax2.scatter(x_avg, [avg_vals['net_tCO2']], color='blue', s=120, marker='D', label='Net Avg/ha', zorder=6)

    ax1_min = (-plot_df[prim_col] - plot_df[sec_col] - plot_df[tert_col]).min()
    ax1_max = (plot_df['emit_trans_tCO2'] + plot_df['emit_soc_tCO2'] + plot_df['emit_n_tCO2']).max()
    ax1_bound = max(abs(ax1_min), abs(ax1_max)) * 1.15  
    ax1.set_ylim(-ax1_bound, ax1_bound)

    ax2_min = -avg_vals[prim_col] - avg_vals[sec_col] - avg_vals[tert_col]
    ax2_max = avg_vals['emit_trans_tCO2'] + avg_vals['emit_soc_tCO2'] + avg_vals['emit_n_tCO2']
    ax2_bound = max(abs(ax2_min), abs(ax2_max)) * 1.6  
    ax2.set_ylim(-ax2_bound, ax2_bound)

    ax1.axhline(0, color='black', linewidth=1)
    ax1.set_xticks(range(6))
    ax1.set_xticklabels(labels, fontsize=12, fontweight='bold')
    ax1.set_ylabel('Total Regional Impact ($tCO_{2}$)', fontsize=14, color='black')
    ax2.set_ylabel('Average Intensity ($tCO_{2}$ / hectare)', fontsize=14, color='blue')
    plt.title(f'{scenario_name} Climate Impact: Regional Totals vs. System Avg/ha', fontsize=16, fontweight='bold', pad=20)

    lines, labels_l = ax1.get_legend_handles_labels()
    lines2, labels2 = ax2.get_legend_handles_labels()
    
    by_label = dict(zip(labels_l + labels2, lines + lines2))
    ax1.legend(by_label.values(), by_label.keys(), loc='upper left', bbox_to_anchor=(1.1, 1), frameon=True)
    
    ax1.axvline(4.5, color='gray', linestyle='--', alpha=0.9)
    plt.tight_layout()

    combined_plot_path = os.path.join(PLOT_OUTPUT_FOLDER, f'{scenario_name.lower()}_combined_regional_avg.png')
    plt.savefig(combined_plot_path, dpi=400, bbox_inches='tight')
    plt.close()

